# Copier en .env (jamais committé) et remplacer chaque valeur.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development

# --- API ---
API_PORT=4380
# Origine publique du front (WebAuthn + CORS). En dev : Vite.
PUBLIC_ORIGIN=http://localhost:5173
# Relying Party ID WebAuthn = domaine (sans port ni schéma).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SafeWay

# --- Données ---
DATABASE_URL=postgres://safeway:CHANGE_ME_DB_PASSWORD@localhost:5432/safeway
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# Secret HMAC des jetons de vote anonymes (lie un vote à un couple utilisateur/événement
# sans stocker l'identifiant utilisateur). Rotation : changer la valeur invalide
# seulement l'anti-double-vote des événements actifs (durée de vie < 1 h).
VOTE_TOKEN_SECRET=CHANGE_ME
# Secret HMAC pour pseudonymiser les clés de rate limiting (IP, compte).
RATE_LIMIT_SECRET=CHANGE_ME

# Clé privée Ed25519 signant les signalements (vérification hors réseau). Obligatoire en production,
# identique sur toutes les instances. Générer :
#   node -e "const c=require('crypto');console.log(c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64url'))"
# EVENT_SIGNING_KEY=

# --- Docker compose ---
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Production uniquement (docker-compose.prod.yml) : domaine public servi en HTTPS.
# SAFEWAY_DOMAIN=safeway.example.org

# --- Front (optionnel) ---
# Centre de carte par défaut tant que le GPS est inactif : "lng,lat".
# VITE_DEFAULT_CENTER=6.0241,47.2378
